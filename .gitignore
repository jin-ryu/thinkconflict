# IDE / OS
.idea/
.vscode/
.DS_Store
~$*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# 원본 데이터는 git에 넣지 않는다 — download.sh로 재현 (계획서 §2)
data/1_raw/dragged/
data/1_raw/qacc/
data/1_raw/ramdocs/
!data/1_raw/download.sh
!data/1_raw/checksums.lock
!data/1_raw/LICENSES/

# data/3_processed/는 커밋한다 — 중간 CSV(사람이 채운 라벨)는 재현 불가능한 인간 노동의
# 산물이라 이력으로 남겨야 하고, 검토 상태를 그대로 추적하기 위해서다 (계획서 §5).
# ※ 원본 문서 본문이 포함되므로, 논문 공개용 익명 미러를 만들 때는 데이터셋 라이선스를
#   확인할 것 — QACC 파생물은 CC BY-SA 3.0(저작자 표시 + 동일조건변경허락) 대상이다.
#   라이선스 사본: data/1_raw/LICENSES/

# 실행 산출물: raw 생성물은 git 미포함, 집계만 포함 (계획서 §3)
results/raw/
results/**/generations/
*.log
references/
